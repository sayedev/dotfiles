# @TODO: finish replacing the colors here


# Menu
menu.border.color: #bcbcb2

menu.title.bg: Solid Flat
menu.title.bg.color: #0e0e1e
menu.title.bg.shadow: 0
menu.title.text.color: #888a85
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #0e0e1e
menu.items.text.color: #888a85
menu.items.disabled.text.color: #696b6b

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #cd1732
menu.items.active.text.color: #888a85

menu.separator.color: #696b6b
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #0e0e1e

# Active window
window.active.border.color: #a29983


window.active.title.bg: flat solid
window.active.title.bg.color: #0e0e1e
window.active.title.separator.color: #0e0e1e
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #888a85

window.active.handle.bg: flat solid
window.active.handle.bg.color: #0e0e1e

window.active.grip.bg: flat solid
window.active.grip.bg.color: #0e0e1e

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #0e0e1e
window.active.button.unpressed.image.color: #888a85

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #cd1732
window.active.button.pressed.image.color: #0e0e1e

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #0e0e1e
window.active.button.disabled.image.color: #696b6b

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #0e0e1e
window.active.button.hover.image.color: #cd1732

#window.active.button.toggled.bg: #cd1732
#window.active.button.toggled.image.color: #0e0e1e

# Inactive window
window.inactive.border.color: #0e0e1e

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0e0e1e
window.inactive.title.separator.color: #0e0e1e
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #696b6b

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #0e0e1e

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #0e0e1e

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #0e0e1e
window.inactive.button.unpressed.image.color: #696b6b

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #cd1732
window.inactive.button.pressed.image.color: #0e0e1e

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #696b6b
window.inactive.button.disabled.image.color: #0e0e1e

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #0e0e1e
window.inactive.button.hover.image.color: #cd1732


# OSD
osd.border.width: 1
osd.border.color: #cd1732

osd.bg: flat solid
osd.bg.color: #0e0e1e
osd.label.bg: flat solid
osd.label.bg.color: #0e0e1e
osd.label.text.color: #888a85

# OSD
osd.bg: Solid Flat
osd.bg.color: #0e0e1e
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #cd1732
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #0e0e1e

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #7d6063
#osd.button.unpressed.*.border.color: #0e0e1e

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #cd1732
#osd.button.pressed.*.border.color: #0e0e1e

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #bcbcb2
#osd.button.focused.*.border.color: #0e0e1e

osd.button.focused.box.color: #cd1732


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
